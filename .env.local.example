# 앱 URL (초대코드 공유 링크 생성에 사용)
# dev: http://localhost:3000 / prod: Vercel 배포 URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Supabase (개발: harutodo_dev / 운영: harutodo)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase CLI — 계정 Access Token (supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Web Push / VAPID (npx web-push generate-vapid-keys 로 생성)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Kakao API (장소 검색 + 지도 미리보기) — kakao.com/developers 에서 발급
# REST API 키: 서버 전용 (절대 NEXT_PUBLIC_ 로 노출 금지)
KAKAO_REST_API_KEY=your-kakao-rest-api-key
# JavaScript 키: 카카오 지도 SDK 클라이언트 렌더링에 사용
NEXT_PUBLIC_KAKAO_MAP_KEY=your-kakao-javascript-key
